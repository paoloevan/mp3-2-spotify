# =============================================================================
# Spotify Developer Credentials (Required for Spotify Sync)
# Create an app at: https://developer.spotify.com/dashboard
# Set Redirect URI to: http://127.0.0.1:8501
# =============================================================================
SPOTIPY_CLIENT_ID="your_spotify_client_id_here"
SPOTIPY_CLIENT_SECRET="your_spotify_client_secret_here"
SPOTIPY_REDIRECT_URI="http://127.0.0.1:8501"

# =============================================================================
# Audio Source & RSS Configuration
# =============================================================================
# Local directory where podcast/radio episodes (.mp3, .mp4, .m4a) are stored
AUDIO_DIR="./episodes"

# Optional: Podcast RSS Feed URL to automatically download new episodes
# Leave empty if you manage downloads externally (e.g., via Rhythmbox, gPodder)
RSS_FEED_URL=""
RSS_MAX_EPISODES="5"

# =============================================================================
# Audio Compression Settings
# =============================================================================
# Automatically convert .mp4/.m4a files to .mp3 to save ~50% disk space
COMPRESS_TO_MP3="true"
MP3_BITRATE="160k"
DELETE_ORIGINAL_AFTER_CONVERT="true"

# =============================================================================
# Spotify Playlist Configuration
# =============================================================================
# Name, ID, or URL of your main cumulative playlist (duplicates are skipped)
SPOTIFY_MAIN_PLAYLIST="MB"

# Also create a new playlist for each episode named "<PREFIX> YYYY-MM-DD"
SPOTIFY_CREATE_DATED_PLAYLIST="true"
SPOTIFY_DATED_PLAYLIST_PREFIX="mb"

# Playlist visibility: "false" = private (recommended), "true" = public
SPOTIFY_PLAYLIST_PUBLIC="false"

# =============================================================================
# Adaptive Shazam Scanner Settings
# =============================================================================
# Step in seconds when speech or silence is detected
SCAN_BASE_STEP="45"

# Step in seconds when a song is recognized and still playing
SCAN_SKIP_STEP="90"

# Length of each temporary audio sample in seconds
SCAN_SAMPLE_LEN="15"

# Delay in seconds between Shazam API queries to avoid HTTP 429 rate-limits
SCAN_REQUEST_DELAY="3.5"
